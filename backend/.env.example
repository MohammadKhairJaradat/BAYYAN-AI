# =============================================================================
# Backend environment configuration — TEMPLATE
# =============================================================================
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
#
# This file is read by pydantic-settings at startup (see app/config.py).
# Every key here maps 1:1 to a field on the `Settings` class.
# Restart the backend after any change for it to take effect.
#
# `.env` is gitignored and may hold real secrets.
# `.env.example` (this file) is safe to commit — keep it free of real keys.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# The credentials below MUST match docker-compose.yml at the repo root.
DATABASE_URL=postgresql+asyncpg://postgres:GRADUATIONPROJECT2026@localhost:5432/jordanian_tax


# ─────────────────────────────────────────────────────────────────────────────
# JWT authentication
# ─────────────────────────────────────────────────────────────────────────────
# APP_ENV=production requires a unique SECRET_KEY of at least 32 characters,
# uses Secure refresh cookies, and allows only FRONTEND_ORIGIN for cookie writes.
# SECRET_KEY signs access + refresh tokens. Changing it logs users out.
# Refresh tokens live only in an HttpOnly cookie and a hashed server session.
# Generate a new one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7


# ─────────────────────────────────────────────────────────────────────────────
# MinIO object storage (uploaded documents)
# ─────────────────────────────────────────────────────────────────────────────
# Credentials must match the MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in
# docker-compose.yml. MINIO_SECURE=false because the local dev MinIO is HTTP.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tax-documents
MINIO_SECURE=false

# Avatars live in a SEPARATE MinIO bucket with a public-read policy so the
# browser can load them directly via <img src> (no Bearer auth on image tags).
# In production, point MINIO_PUBLIC_URL at the CDN/origin in front of object
# storage (e.g. https://cdn.example.com). Locally it's the MinIO HTTP endpoint.
MINIO_AVATAR_BUCKET=avatars
MINIO_PUBLIC_URL=http://localhost:9000


# ─────────────────────────────────────────────────────────────────────────────
# SQL logging
# ─────────────────────────────────────────────────────────────────────────────
# When true, SQLAlchemy logs every SQL statement to the console. Useful for
# debugging queries; very noisy in normal use. Turn off in production.
SQL_ECHO=true


# =============================================================================
# LLM API KEYS (credentials)
# =============================================================================
# These are PASSWORDS for each provider's API. They unlock access — they do NOT
# decide which provider gets called. The "router" settings further down
# (LLM_PROVIDER, ADVISOR_LLM_PROVIDER) decide that.
#
# Rule of thumb: set ONLY the keys for providers you actually plan to use.
# Leave the rest blank. The code raises a clear error like
# "GROQ_API_KEY not set in .env" the moment a feature tries to use a blank key.
#
# Where to get each key:
#   ANTHROPIC_API_KEY  → https://console.anthropic.com/settings/keys  (paid)
#   OPENAI_API_KEY     → https://platform.openai.com/api-keys         (paid)
#   GEMINI_API_KEY     → https://aistudio.google.com/apikey           (free tier)
#   GROQ_API_KEY       → https://console.groq.com/keys                (free tier)
#   GOOGLE_AI_API_KEY  → https://aistudio.google.com/apikey           (free tier — voice STT preferred)
#
# Note on the two Google keys: GEMINI_API_KEY and GOOGLE_AI_API_KEY come from
# the same Google AI Studio page. They're declared separately because they
# power different features (text/chat/extraction vs. voice/extraction).
# Voice and document extraction prefer GOOGLE_AI_API_KEY but fall back to
# GEMINI_API_KEY, so one Google AI Studio key can serve both.
# Restart the backend after changing keys; settings load at process start.
# =============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Chat router (qa.py) — used by POST /api/v1/rag/* endpoints
# ─────────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER picks WHICH provider the chatbot calls when answering questions.
# Code at backend/app/rag/qa.py:245 does an if/elif on this string.
# The matching X_API_KEY above must be filled in for the chosen provider.
#
# Allowed values:
#   anthropic  → Claude (claude-opus-4-7)     best quality;        requires ANTHROPIC_API_KEY
#   openai     → GPT-5.4                      high quality;        requires OPENAI_API_KEY
#   gemini     → Gemini 2.5 Flash             good quality;        requires GEMINI_API_KEY or GOOGLE_AI_API_KEY
#   groq       → Llama 3.1 8b Instant         free, fast, weaker;  requires GROQ_API_KEY
#
# Recommendation:
#   - Demo / student project → groq      (free tier, no payment method needed)
#   - Production             → anthropic (highest legal-reasoning quality)
#
# Chat/title model names are configurable below. The UI can still send an exact
# model per request; these values are the backend fallback defaults.
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_TITLE_MODEL=gemini-2.5-flash
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_TITLE_MODEL=gpt-5.4
ANTHROPIC_CHAT_MODEL=claude-opus-4-7
ANTHROPIC_TITLE_MODEL=claude-opus-4-7
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_TITLE_MODEL=llama-3.1-8b-instant


# ─────────────────────────────────────────────────────────────────────────────
# Voice transcription (Gemini clip STT) - used by /api/v1/voice/transcribe
# ─────────────────────────────────────────────────────────────────────────────
# Speech-to-text for the voice-input feature. Uses GOOGLE_AI_API_KEY above
# when present, otherwise falls back to GEMINI_API_KEY.
# Restart uvicorn after changing either Google key.
#
# GEMINI_TRANSCRIBE_MODEL is used with generateContent on short WAV clips from
# the browser mic.
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash


# ─────────────────────────────────────────────────────────────────────────────
# Advisor router (LangGraph) — used by POST /api/v1/advisor/{id}/run
# ─────────────────────────────────────────────────────────────────────────────
# The advisor runs three LLM-driven nodes (analyze_deductions, assess_risk,
# generate_plan). It is INDEPENDENT from the chat — pick a different provider
# here if you want. For example: groq for fast chat + anthropic for the
# (less-frequent, higher-stakes) advisor report.
#
# ── ADVISOR_LLM_PROVIDER ──────────────────────────────────────────────────
# Picks WHICH provider the advisor calls. Same allowed values as LLM_PROVIDER:
#   anthropic | openai | gemini | groq
# The matching X_API_KEY must be set.
#
# ── ADVISOR_LLM_MODEL ─────────────────────────────────────────────────────
# The exact model name to call. UNLIKE qa.py, this is configurable here.
# Pick a model that EXISTS on the chosen provider:
#   anthropic: claude-opus-4-7 | claude-sonnet-4-5 | claude-3-5-sonnet-latest
#   openai:    gpt-4o | gpt-4o-mini
#   gemini:    gemini-2.5-flash | gemini-2.5-pro | gemini-3-pro-preview
#   groq:      llama-3.3-70b-versatile
#              (avoid 8b models — too weak for Arabic legal reasoning)
#
# ── ADVISOR_LLM_MAX_TOKENS ────────────────────────────────────────────────
# Maximum output tokens per LLM call. 2048 is enough for the structured JSON
# the advisor expects. Raise if you ever see truncated responses in the report.
#
# Recommendation for legal-analysis quality (best → acceptable):
#   anthropic / claude-opus-4-7           best (paid)
#   gemini    / gemini-2.5-flash          very good (free tier available)
#   openai    / gpt-4o                    very good (paid)
#   groq      / llama-3.3-70b-versatile   acceptable for demos (free)
ADVISOR_LLM_PROVIDER=gemini
ADVISOR_LLM_MODEL=gemini-2.5-flash
ADVISOR_LLM_MAX_TOKENS=2048


# ─────────────────────────────────────────────────────────────────────────────
# Document extraction (Gemini primary + Claude fallback)
# ─────────────────────────────────────────────────────────────────────────────
# Document extraction runs through external vision APIs. Gemini is tried first
# for low latency/cost; Claude Sonnet vision is used only when Gemini errors or
# self-reports confidence below EXTRACTION_CONFIDENCE_THRESHOLD.
#
# Required keys:
#   Gemini primary: GOOGLE_AI_API_KEY or GEMINI_API_KEY
#   Claude fallback: ANTHROPIC_API_KEY
#
# Restart uvicorn after changing any key or model value.
EXTRACTION_GEMINI_MODEL=gemini-2.5-flash
EXTRACTION_CLAUDE_MODEL=claude-sonnet-4-20250514
EXTRACTION_CONFIDENCE_THRESHOLD=0.65


# ─────────────────────────────────────────────────────────────────────────────
# Local retrieval index
# ─────────────────────────────────────────────────────────────────────────────
# Local RAG index (no paid provider). Changing model/revision/version selects a
# separate Chroma collection; run scripts/ingest_knowledge_base.py for it.
# Old collections and source revisions stay available; do not delete them as a
# routine upgrade. The bundled corpus is demo-only.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_REVISION=3d7cfbdacd47fdda877c5cd8a79fbcc4f2a574f3
RAG_COLLECTION_VERSION=2


# ─────────────────────────────────────────────────────────────────────────────
# Admin bootstrap
# ─────────────────────────────────────────────────────────────────────────────
# There is no login-time username allowlist. Register the account, then run:
#   uv run python -m app.auth.bootstrap_admin YOUR_USERNAME
# Run from backend/ against the intended DATABASE_URL. The grant is audited.
